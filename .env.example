# Copia este archivo a .env y ajusta si lo necesitas.
# Las credenciales de Gmail se configuran desde la interfaz web (tabla settings),
# no hace falta ponerlas aqui.

POSTGRES_USER=organizador
POSTGRES_PASSWORD=organizador
POSTGRES_DB=organizador

DATABASE_URL=postgresql+psycopg2://organizador:organizador@postgres:5432/organizador
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# Origenes permitidos por el gateway (separados por coma).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
